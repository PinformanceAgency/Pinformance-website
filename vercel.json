    },
    {
      "path": "/api/cron/delivery-meeting/targets",
      "schedule": "30 7 * * 2"
    },
    {
      "path": "/api/cron/delivery-meeting/compute",
      "schedule": "0 8 * * 2"
    },
    {
      "path": "/api/cron/delivery-meeting/briefs",
      "schedule": "15-55/10 8 * * 2"
    },
    {
      "path": "/api/cron/delivery-meeting/render",
      "schedule": "0 9 * * 2"
    },
    {
      "path": "/api/cron/delivery-meeting/deliver",
      "schedule": "15-45/15 9 * * 2"
    },
    {
      "path": "/api/cron/delivery-meeting/check",
      "schedule": "30 10 * * 2"
    }
