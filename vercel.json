{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/cron/post-pins",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/organic-post-pins",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/organic-health",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/organic-pacing",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/organic-pull-analytics",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/health-check",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/pull-analytics",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/board-metrics",
      "schedule": "30 * * * *"
