    {
      "path": "/api/cron/weekly-update-check",
      "schedule": "0 13 * * 1"
    },
    {
      "path": "/api/cron/fx-rates",
      "schedule": "30 6 * * *"
    },
    {
      "path": "/api/cron/verify-metrics",
