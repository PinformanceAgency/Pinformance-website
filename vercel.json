{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/cron/post-pins",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/health-check",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/pull-analytics",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/board-metrics",
      "schedule": "30 * * * *"
    },
    {
      "path": "/api/cron/optimize-prompts",
      "schedule": "0 3 * * 1"
    },
    {
      "path": "/api/cron/refresh-pinterest-tokens",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/snapshot-pinterest",
      "schedule": "30 */6 * * *"
    },
    {
      "path": "/api/cron/snapshot-metrics",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/cron/refresh-team-activity",
      "schedule": "15 */6 * * *"
    },
    {
      "path": "/api/cron/weekly-update-seed",
      "schedule": "0 1 * * 1"
    },
    {
      "path": "/api/cron/weekly-update-sync",
      "schedule": "0 12 * * 1"
    },
    {
      "path": "/api/cron/fx-rates",
      "schedule": "30 6 * * *"
    }
  ]
}
